datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
}

generator client {
provider = "prisma-client-js"
}

// 1. The Streamer Account
model User {
id        String   @id @default(uuid())
username  String   @unique // Used for their tipping page URL and OBS link
email     String   @unique
password  String
createdAt DateTime @default(now())

// Relations
donations      Donation[]
widgetSettings WidgetSettings?
}

// 2. OBS Widget Configuration (How the alert looks on stream)
model WidgetSettings {
id             String  @id @default(uuid())
userId         String  @unique
user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

// Customization for the OBS Browser Source
alertImage     String? @default("https://media.giphy.com/media/xT0xezQGU5xCDJuCPe/giphy.gif") // Default GIF
alertSound     String? @default("default-chime.mp3")
alertDuration  Int     @default(5000) // How long it stays on screen in milliseconds
minDonation    Float   @default(1.00) // Minimum tip to trigger an alert
textColor      String  @default("#ffffff")

createdAt      DateTime @default(now())
updatedAt      DateTime @updatedAt
}

// 3. The Tips/Donations received from viewers
model Donation {
id        String   @id @default(uuid())
userId    String   // The streamer receiving the tip
user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

donorName String   @default("Anonymous")
amount    Float
message   String?  // The text that will be read out/displayed on the OBS alert

createdAt DateTime @default(now())

@@index([userId])
}
